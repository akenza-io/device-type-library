{
  "$id": "https://akenza.io/watecco/vaqaOLite/configuration.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "processingType": "uplink_decoder",
  "topic": "configuration",
  "title": "Configuration",
  "properties": {
    "firmwareVersion": {
      "title": "Firmware version",
      "description": "Firmware version",
      "type": "string",
      "hideFromKpis": true
    },
    "kernel": {
      "title": "Kernel",
      "description": "Kernel version",
      "type": "string",
      "hideFromKpis": true
    },
    "manufacturer": {
      "title": "Manufacturer",
      "description": "Manufacturer name",
      "type": "string",
      "hideFromKpis": true
    },
    "model": {
      "title": "Model",
      "description": "Model name",
      "type": "string",
      "hideFromKpis": true
    },
    "productionDate": {
      "title": "Production date",
      "description": "Production date",
      "type": "string",
      "hideFromKpis": true
    },
    "position": {
      "title": "Position",
      "description": "Configured position",
      "type": "string",
      "hideFromKpis": true
    },
    "applicationName": {
      "title": "Application name",
      "description": "Configured application name",
      "type": "string",
      "hideFromKpis": true
    },
    "messageType": {
      "title": "Message type",
      "description": "LoRaWAN message type",
      "type": "string",
      "hideFromKpis": true,
      "enum": [
        "CONFIRMED",
        "UNCONFIRMED"
      ]
    },
    "retries": {
      "title": "Retries",
      "description": "Number of LoRaWAN retries",
      "type": "integer",
      "hideFromKpis": true
    },
    "rejoinPeriod": {
      "title": "Rejoin period",
      "description": "Automatic rejoin period in minutes",
      "type": "integer",
      "hideFromKpis": true,
      "unit": "min"
    },
    "rejoinErrorFrames": {
      "title": "Rejoin error frames",
      "description": "Number of erroneous frames before an automatic rejoin",
      "type": "integer",
      "hideFromKpis": true
    },
    "dataRate": {
      "title": "Data rate",
      "description": "LoRaWAN data rate",
      "type": "integer",
      "hideFromKpis": true
    },
    "abpDevAddress": {
      "title": "ABP device address",
      "description": "ABP device address",
      "type": "string",
      "hideFromKpis": true
    },
    "otaAppEui": {
      "title": "OTA AppEUI",
      "description": "OTA application EUI",
      "type": "string",
      "hideFromKpis": true
    }
  },
  "required": []
}
