{
  "$id": "https://akenza.io/sensocon/WM/lifecycle.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "processingType": "uplink_decoder",
  "topic": "lifecycle",
  "title": "Lifecycle",
  "properties": {
    "batteryVoltage": {
      "$ref": "https://raw.githubusercontent.com/akenza-io/device-type-library/main/data-models/device/schema.json#/$defs/batteryVoltage/volt"
    },
    "payloadVersion": {
      "title": "Payload version",
      "description": "Header byte of the uplink. SD-0178 uses it for version control.",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "hideFromKpis": true
    }
  },
  "required": ["batteryVoltage", "payloadVersion"]
}
