{
  "name": "nanoTag",
  "version": "1.0.0",
  "manufacturer": "nanoThings",
  "url": "https://www.nanothingsinc.com/nanotag",
  "description": "Thin, flexible temperature tag with a printed antenna and an ultra-thin flexible battery. Records temperature at intervals and is used for temperature monitoring of goods, packages and cold chain shipments.",
  "author": "Akenza AG",
  "firmwareVersion": "V1.0.0",
  "loraDeviceClass": "A",
  "availableSensors": ["Temperature"],
  "outputTopics": [
    "configuration_ack",
    "device_status",
    "first_timestamp",
    "lifecycle",
    "report_frame",
    "temperature"
  ],
  "encoding": "HEX",
  "connectivity": "LORA",
  "useCases": [
    "Cold Chain & Temperature Compliance"
  ],
  "keywords": [
    "nanoThings",
    "nanoTag",
    "temperature tag",
    "temperature logger",
    "flexible",
    "cold chain",
    "shipment",
    "package",
    "logistics",
    "LoRaWAN"
  ]
}
