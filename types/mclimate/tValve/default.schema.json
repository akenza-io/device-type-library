{
  "$id": "https://akenza.io/mclimate/tValve/default.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "processingType": "uplink_decoder",
  "topic": "default",
  "title": "Default",
  "properties": {
    "waterTemperature": {
      "$ref": "https://raw.githubusercontent.com/akenza-io/device-type-library/main/data-models/environment/schema.json#/$defs/temperature/celsius",
      "title": "Water temperature",
      "description": "Water temperature in °C"
    },
    "ambientTemperature": {
      "$ref": "https://raw.githubusercontent.com/akenza-io/device-type-library/main/data-models/environment/schema.json#/$defs/temperature/celsius",
      "title": "Ambient temperature",
      "description": "Ambient temperature in °C"
    },
    "valveOpen": {
      "title": "Valve open",
      "description": "Equals true if the valve is open",
      "type": "boolean"
    }
  },
  "required": ["waterTemperature", "ambientTemperature", "valveOpen"]
}
