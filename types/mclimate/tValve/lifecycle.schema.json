{
  "$id": "https://akenza.io/mclimate/tValve/lifecycle.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "processingType": "uplink_decoder",
  "topic": "lifecycle",
  "title": "Lifecycle",
  "properties": {
    "batteryVoltage": {
      "$ref": "https://raw.githubusercontent.com/akenza-io/device-type-library/main/data-models/device/schema.json#/$defs/batteryVoltage/volt"
    },
    "batteryTooLow": {
      "title": "Battery too low",
      "description": "Equals true if the battery voltage is dangerously low",
      "type": "boolean"
    },
    "softwareVersion": {
      "title": "Software version",
      "description": "Device software version",
      "type": "integer",
      "hideFromKpis": true
    }
  },
  "required": ["batteryVoltage", "batteryTooLow", "softwareVersion"]
}
