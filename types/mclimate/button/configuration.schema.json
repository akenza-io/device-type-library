{
  "$id": "https://akenza.io/mclimate/button/configuration.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "processingType": "uplink_decoder",
  "topic": "configuration",
  "title": "Configuration",
  "properties": {
    "deviceVersions": {
      "title": "Device versions",
      "description": "Hardware and software version of the device",
      "type": "object",
      "hideFromKpis": true
    },
    "keepAliveTime": {
      "title": "Keepalive interval",
      "description": "Interval between periodic uplinks in minutes",
      "type": "integer",
      "unit": "min",
      "hideFromKpis": true
    },
    "joinRetryPeriod": {
      "title": "Join retry period",
      "description": "Period between join attempts in minutes",
      "type": "number",
      "unit": "min",
      "hideFromKpis": true
    },
    "uplinkType": {
      "title": "Uplink type",
      "description": "0 = unconfirmed uplinks, 1 = confirmed uplinks",
      "type": "integer",
      "hideFromKpis": true
    },
    "watchDogParams": {
      "title": "Watchdog parameters",
      "description": "Number of confirmed (wdpC) and unconfirmed (wdpUc) uplinks without a downlink before rejoining, false if disabled",
      "type": "object",
      "hideFromKpis": true
    },
    "region": {
      "title": "Region",
      "description": "LoRaWAN region of the device",
      "type": "integer",
      "hideFromKpis": true
    },
    "sendEventLater": {
      "title": "Send event later",
      "description": "Send event later setting",
      "type": "integer",
      "hideFromKpis": true
    },
    "singlePressEventCounter": {
      "title": "Single press counter",
      "description": "Number of single press events",
      "type": "integer",
      "hideFromKpis": true
    },
    "doublePressEventCounter": {
      "title": "Double press counter",
      "description": "Number of double press events",
      "type": "integer",
      "hideFromKpis": true
    },
    "triplePressEventCounter": {
      "title": "Triple press counter",
      "description": "Number of triple press events",
      "type": "integer",
      "hideFromKpis": true
    }
  }
}
