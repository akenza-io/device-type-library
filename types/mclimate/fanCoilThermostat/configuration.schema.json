      "type": "integer",
      "hideFromKpis": true
    },
    "heatingCoolingTargetTempRangesUnoccupied": {
      "title": "Unoccupied heating and cooling target temperature ranges",
      "description": "Minimum and maximum target temperature for heating and cooling when unoccupied in °C",
      "type": "object",
      "hideFromKpis": true
    },
    "fanOffDelayTime": {
      "title": "Fan off delay time",
      "description": "Fan off delay time",
      "type": "integer",
      "hideFromKpis": true
    },
    "additionalFanMode": {
      "title": "Additional fan mode",
      "description": "0 = turn off when the target is reached, 1 = keep on when the target is reached, 2 = fan always on",
      "type": "integer",
      "hideFromKpis": true
    },
    "internalTemperatureSensorError": {
      "title": "Internal temperature sensor error",
      "description": "Internal temperature sensor error",
      "type": "integer",
      "hideFromKpis": true
    },
    "externalTemperatureSensorError": {
      "title": "External temperature sensor error",
      "description": "External temperature sensor error",
      "type": "integer",
      "hideFromKpis": true
    },
    "displayColorMode": {
      "title": "Display color mode",
      "description": "0 = light, 1 = dark",
      "type": "integer",
      "hideFromKpis": true
    },
    "userInterfaceLanguage": {
      "title": "User interface language",
      "description": "0 = English, 1 = French, 2 = German, 3 = Spanish",
      "type": "integer",
      "hideFromKpis": true
    }
