      "hideFromKpis": true
    },
    "ecmStartUpTime": {
      "title": "ECM start-up time",
      "description": "ECM fan start-up time",
      "type": "integer",
      "hideFromKpis": true
    },
    "ecmRelay": {
      "title": "ECM relay",
      "description": "ECM relay setting",
