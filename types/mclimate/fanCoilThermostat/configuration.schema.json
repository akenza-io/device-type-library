    "coolingSetpointNotOccupied": {
      "title": "Unoccupied cooling setpoint",
      "description": "Cooling setpoint when unoccupied in °C",
      "type": "integer",
      "unit": "°C",
      "hideFromKpis": true
    },
    "heatingSetpointNotOccupied": {
      "title": "Unoccupied heating setpoint",
      "description": "Heating setpoint when unoccupied in °C",
      "type": "integer",
      "unit": "°C",
      "hideFromKpis": true
    },
    "tempSensorCompensation": {
      "title": "Temperature sensor compensation",
      "description": "Compensation sign and value in °C applied to the measured temperature",
      "type": "object",
      "hideFromKpis": true
    },
    "fanSpeedNotOccupied": {
      "title": "Unoccupied fan speed",
      "description": "0 = low, 1 = automatic, 2 = don't change",
      "type": "integer",
      "hideFromKpis": true
    },
    "automaticChangeover": {
      "title": "Automatic changeover",
      "description": "Automatic changeover setting",
      "type": "integer",
      "hideFromKpis": true
    },
    "wiringDiagram": {
      "title": "Wiring diagram",
      "description": "Configured wiring diagram",
      "type": "integer",
      "hideFromKpis": true
    },
    "occFunction": {
      "title": "Occupancy function",
      "description": "Occupancy input function",
      "type": "integer",
      "hideFromKpis": true
    },
    "automaticChangeoverThreshold": {
      "title": "Automatic changeover threshold",
      "description": "Cooling and heating thresholds of the automatic changeover",
      "type": "object",
      "hideFromKpis": true
    },
    "deviceStatus": {
      "title": "Device status",
      "description": "0 = off, 1 = on",
      "type": "integer",
      "hideFromKpis": true
    },
    "returnOfPowerOperation": {
      "title": "Return of power operation",
      "description": "0 = last status, 1 = on, 2 = off",
      "type": "integer",
      "hideFromKpis": true
