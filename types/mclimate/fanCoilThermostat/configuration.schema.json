{
  "$id": "https://akenza.io/mclimate/fanCoilThermostat/configuration.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "processingType": "uplink_decoder",
  "topic": "configuration",
  "title": "Configuration",
  "properties": {
    "deviceVersions": {
      "title": "Device versions",
      "description": "Hardware and software version of the device",
      "type": "object",
      "hideFromKpis": true
    },
    "keepAliveTime": {
      "title": "Keepalive interval",
      "description": "Interval between periodic uplinks in minutes",
      "type": "integer",
      "unit": "min",
      "hideFromKpis": true
    },
    "joinRetryPeriod": {
      "title": "Join retry period",
      "description": "Period between join attempts in minutes",
      "type": "number",
      "unit": "min",
      "hideFromKpis": true
    },
    "uplinkType": {
      "title": "Uplink type",
      "description": "0 = unconfirmed uplinks, 1 = confirmed uplinks",
      "type": "integer",
      "hideFromKpis": true
    },
    "watchDogParams": {
      "title": "Watchdog parameters",
      "description": "Number of confirmed (wdpC) and unconfirmed (wdpUc) uplinks without a downlink before rejoining, false if disabled",
      "type": "object",
      "hideFromKpis": true
    },
    "region": {
      "title": "Region",
      "description": "LoRaWAN region of the device",
      "type": "integer",
      "hideFromKpis": true
    },
    "targetTemperatureStep": {
      "title": "Target temperature step",
      "description": "Target temperature step in °C",
      "type": "number",
      "unit": "°C",
      "hideFromKpis": true
    },
    "keysLock": {
      "title": "Keys lock",
      "description": "0 = no keys locked, 1 = all keys, 2 = on/off and mode change, 3 = on/off, 4 = all keys except on/off, 5 = mode change",
      "type": "integer",
      "hideFromKpis": true
    },
    "temperatureRangeSettings": {
      "title": "Temperature range",
      "description": "Minimum and maximum target temperature in °C",
      "type": "object",
      "hideFromKpis": true
    },
    "heatingCoolingTargetTempRanges": {
      "title": "Heating and cooling target temperature ranges",
      "description": "Minimum and maximum target temperature for heating and cooling in °C",
      "type": "object",
      "hideFromKpis": true
    },
    "targetTemperature": {
      "title": "Target temperature",
      "description": "Target temperature in °C",
      "type": "number",
      "unit": "°C",
      "hideFromKpis": true
    },
    "manualTargetTemperatureUpdate": {
      "title": "Manual target temperature update",
      "description": "Target temperature set manually on the device in °C",
      "type": "number",
      "unit": "°C",
      "hideFromKpis": true
    },
    "valveOpenCloseTime": {
      "title": "Valve open/close time",
      "description": "Valve open/close time",
      "type": "integer",
      "hideFromKpis": true
    },
    "displayRefreshPeriod": {
      "title": "Display refresh period",
      "description": "Display refresh period",
      "type": "integer",
      "hideFromKpis": true
    },
    "extAutomaticTemperatureControl": {
      "title": "External automatic temperature control",
      "description": "0 = deactivated, 1 = activated",
      "type": "integer",
      "hideFromKpis": true
    },
    "extSensorTemperature": {
      "title": "External sensor temperature",
      "description": "Temperature received from an external sensor in °C",
      "type": "number",
      "unit": "°C",
      "hideFromKpis": true
    },
    "currentTemperatureVisibility": {
      "title": "Temperature visibility",
      "description": "0 = the measured temperature is hidden on the display, 1 = shown",
      "type": "integer",
      "hideFromKpis": true
    },
    "humidityVisibility": {
      "title": "Humidity visibility",
      "description": "0 = the humidity is hidden on the display, 1 = shown",
      "type": "integer",
      "hideFromKpis": true
