    "deltaTemperature1": {
      "title": "Delta temperature 1",
      "description": "Delta temperature 1 in °C",
      "type": "number",
      "unit": "°C",
      "hideFromKpis": true
    },
    "deltaTemperature2and3": {
      "title": "Delta temperatures 2 and 3",
      "description": "Delta temperatures 2 and 3 in °C",
      "type": "object",
      "hideFromKpis": true
    },
    "frostProtectionStatus": {
      "title": "Frost protection status",
      "description": "Frost protection status",
      "type": "integer",
      "hideFromKpis": true
    },
    "occupancySensorStatusSetPoint": {
      "title": "Occupancy sensor status setpoint",
      "description": "Occupancy sensor status setpoint",
      "type": "integer",
      "hideFromKpis": true
    },
    "occupancySensorStatus": {
      "title": "Occupancy sensor status",
      "description": "Occupancy sensor status",
      "type": "integer",
      "hideFromKpis": true
    },
    "dewPointSensorStatus": {
      "title": "Dew point sensor status",
      "description": "Dew point sensor status",
      "type": "integer",
      "hideFromKpis": true
    },
