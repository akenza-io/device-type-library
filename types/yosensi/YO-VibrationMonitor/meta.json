{
  "name": "YO Vibration Monitor",
  "version": "1.0.0",
  "manufacturer": "Yosensi",
  "url": "https://www.yosensi.io/products/yo_vibration_monitor/",
  "description": "Vibration sensor for electric motors that measures RMS and peak acceleration, velocity, displacement and statistical values such as kurtosis. Also measures temperature and humidity for condition monitoring.",
  "author": "Maciej Sacewicz",
  "firmwareVersion": "V1.1.1",
  "availableSensors": [
    "Temperature",
    "Humidity",
    "Accelerometer"
  ],
  "outputTopics": [
    "battery_voltage",
    "internal_temperature",
    "humidity",
    "external_temperature",
    "rms_acceleration",
    "peak_acceleration",
    "rms_velocity",
    "displacement",
    "crest_factor",
    "standard_deviation",
    "kurtosis",
    "skewness"
  ],
  "encoding": "HEX",
  "connectivity": "LORA",
  "useCases": [
    "Condition Monitoring"
  ],
  "keywords": [
    "Yosensi",
    "YO Vibration Monitor",
    "vibration",
    "predictive maintenance",
    "electric motor",
    "RMS acceleration",
    "velocity",
    "displacement",
    "kurtosis",
    "accelerometer",
    "temperature",
    "LoRaWAN"
  ]
}