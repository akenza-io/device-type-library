{
  "$id": "https://akenza.io/browan/TBWaterleak/config.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "processingType": "uplink_decoder",
  "topic": "default",
  "title": "Default",
  "properties": {
    "keepaliveInterval": {
      "title": "Keepalive interval",
      "unit": "sec",
      "type": "integer",
      "description": "Keepalive interval",
      "hideFromKpis": true
    },
    "temperatureDelta": {
      "title": "Temperature delta",
      "description": "Temperature delta",
      "$ref": "https://raw.githubusercontent.com/akenza-io/device-type-library/main/data-models/environment/schema.json#/$defs/temperature/celsius",
      "hideFromKpis": true
    },
    "humidityDelta": {
      "title": "Humidity delta",
      "description": "Humidity delta",
      "$ref": "https://raw.githubusercontent.com/akenza-io/device-type-library/main/data-models/environment/schema.json#/$defs/humidity/percent",
      "hideFromKpis": true
    },
    "sensorDetectionInterval": {
      "title": "Sensor detection interval",
      "unit": "sec",
      "type": "integer",
      "description": "Sensor detection interval",
      "hideFromKpis": true
    }
  },
  "required": [
    "keepaliveInterval",
    "temperatureDelta",
    "humidityDelta",
    "sensorDetectionInterval"
  ]
}